# ---- Database ----
# Production: any Postgres (e.g. Neon / Supabase free tier). Leave unset locally to use embedded PGlite in .data/pglite
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# ---- Market data ----
# Primary (required): Tiingo — adjusted daily history + IEX intraday quotes. https://www.tiingo.com
TIINGO_API_KEY=
# Independent close cross-check (recommended, pick one). Massive (formerly Polygon.io) is preferred.
MASSIVE_API_KEY=
TWELVEDATA_API_KEY=
# SECONDARY_CLOSE_PROVIDER=massive   # or twelvedata

# Verification tolerances (defaults shown)
# CROSSCHECK_TOLERANCE_PCT=0.1
# CROSSCHECK_TOLERANCE_ABS=0.011
# MAX_QUOTE_AGE_MINUTES=20
# MAX_UNCONFIRMED_MOVE_PCT=15

# ---- Email (one of) ----
RESEND_API_KEY=
# SMTP_URL=smtps://user:app-password@smtp.gmail.com:465
EMAIL_FROM=ETF Alerts <alerts@yourdomain.com>
ALERT_EMAIL_TO=

# ---- App ----
APP_URL=http://localhost:3000
# Optional HTTP basic auth for the dashboard (any username)
DASHBOARD_PASSWORD=
# Bearer secret for GET /api/cron (only if using an external scheduler instead of GitHub Actions)
CRON_SECRET=

# ---- NVIDIA AI analysis (server only) ----
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Free-data setup: TIINGO_API_KEY + TWELVEDATA_API_KEY
# Set SECONDARY_CLOSE_PROVIDER=twelvedata and run the evening job for verified closes.
